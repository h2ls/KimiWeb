<Window
    x:Class="KimiWeb.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kimi Web 控制台"
    Width="920"
    Height="600"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部按钮一排  -->
        <StackPanel Margin="12,12,12,8" Orientation="Horizontal">
            <Button
                x:Name="OpenWebButton"
                Padding="18,8"
                Click="OpenWeb_Click"
                Content="Kimi Web"
                FontSize="22"
                FontWeight="Bold" />
            <Button
                x:Name="RestartButton"
                Margin="14,0,0,0"
                Padding="18,8"
                VerticalAlignment="Center"
                Click="Restart_Click"
                Content="重启服务"
                FontSize="22"
                FontWeight="Bold" />
            <Button
                x:Name="StopButton"
                Margin="10,0,0,0"
                Padding="18,8"
                VerticalAlignment="Center"
                Click="Stop_Click"
                Content="关闭服务"
                FontSize="22"
                FontWeight="Bold" />
            <CheckBox
                x:Name="AutoStartBox"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Checked="AutoStart_Changed"
                Content="开机自启动"
                FontSize="14"
                Unchecked="AutoStart_Changed" />
        </StackPanel>

        <!--  服务日志（kimi web 以 log-level info 运行的输出）  -->
        <TextBox
            x:Name="LogBox"
            Grid.Row="1"
            Margin="12,0,12,8"
            AcceptsReturn="True"
            Background="#FF1E1E1E"
            FontFamily="Consolas"
            FontSize="12"
            Foreground="#FFD4D4D4"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="服务状态：已停止" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="UrlText" Text="" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
