<ui:FluentWindow
    x:Class="KimiWeb.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Kimi Web 控制台"
    Width="920"
    Height="640"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <ui:TitleBar Title="Kimi Web 控制台" />

        <!--  顶部操作区  -->
        <StackPanel
            Grid.Row="1"
            Margin="16,14,16,10"
            Orientation="Horizontal">
            <ui:Button
                x:Name="OpenWebButton"
                Appearance="Primary"
                Click="OpenWeb_Click"
                FontSize="15">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Globe24" />
                </ui:Button.Icon>
                Kimi Web
            </ui:Button>
            <ui:Button
                x:Name="RestartButton"
                Margin="10,0,0,0"
                Click="Restart_Click"
                FontSize="15">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
                重启服务
            </ui:Button>
            <ui:Button
                x:Name="StopButton"
                Margin="10,0,0,0"
                Click="Stop_Click"
                FontSize="15">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Power24" />
                </ui:Button.Icon>
                关闭服务
            </ui:Button>
            <ui:ToggleSwitch
                x:Name="AutoStartBox"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Checked="AutoStart_Changed"
                Content="开机自启动"
                Unchecked="AutoStart_Changed" />
        </StackPanel>

        <!--  服务日志（kimi web 以 log-level info 运行的输出）  -->
        <Border
            Grid.Row="2"
            Margin="16,0,16,8"
            Padding="10,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <TextBox
                x:Name="LogBox"
                VerticalAlignment="Stretch"
                AcceptsReturn="True"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                Foreground="#FFD4D4D4"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />
        </Border>

        <!--  底部状态栏  -->
        <Border
            Grid.Row="3"
            Padding="18,12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="#FFF85149" />
                    <TextBlock
                        x:Name="StatusText"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="服务已停止" />
                </StackPanel>
                <TextBlock
                    x:Name="UrlText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
